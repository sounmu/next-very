# Base URL of the MarginLog server (apps/server). Copy to .env and adjust.
# Expo inlines EXPO_PUBLIC_* variables at build time; restart "expo start" after changing them.
# On a phone, "localhost" is the phone itself: use the laptop's LAN IP, the Cloudflare tunnel URL, or the Vercel URL.
EXPO_PUBLIC_API_URL=http://localhost:8787
